# Copy to .env and fill in what you need. All of these are optional for a local
# demo: unset R2 vars skip the offsite sync, and the rest fall back to the
# defaults below (same as astro.config.ts).

# Store encryption passphrase. Must match the passphrase used when the Kloset
# store was created. Changing it later cannot decrypt existing snapshots.
PLAKAR_PASSPHRASE=wayback-demo

# Absolute or relative path to the Kloset store. Defaults to ./.plakar/store.
# PLAKAR_STORE=

# Live docs directory (the "current" version). Defaults to ./src/docs.
# DOCS_DIR=

# Label shown in the operations panel instead of the raw store path.
PLAKAR_STORE_LABEL=@nimbus-docs

# Cloudflare R2 (S3-compatible). Leave the three token vars unset to skip sync.
R2_BUCKET=plakar-docs-archive
R2_OBJECT=kloset-store.tar.gz
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
